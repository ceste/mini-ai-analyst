FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --system appgroup \
    && useradd --system --gid appgroup appuser

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn

COPY lesson12/container_security_api.py /app/lesson12/container_security_api.py

USER appuser

EXPOSE 8000

CMD ["uvicorn", "lesson12.container_security_api:app", \
     "--host", "0.0.0.0", "--port", "8000"]
